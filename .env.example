# Copy to .env and set ZETARIS_ADMIN_PASSWORD before the first start. Docker Compose reads
# .env automatically. Never commit the filled copy: it holds the admin password.
#
# Then sign in at http://localhost:3001 as admin@zetaris.com with that password.

# ---------------------------------------------------------------------------
# Images
# ---------------------------------------------------------------------------
DRIVER_IMAGE=zetarishackathon.azurecr.io/zetaris-ndp-driver:2.4.3-v2.4.3.1-hackathon.cb88df0b255aba5a9a9eda96483fc877cc82df80
API_IMAGE=zetarishackathon.azurecr.io/zetaris-ndp-api:2.4.3-v2.4.3.1-hackathon.a2848d8a41fa21673a0d719deb41b675412710fe
UI_IMAGE=zetarishackathon.azurecr.io/zetaris-new-ui:2.4.3-v2.4.3.1-hackathon.88e49b0db015979a2d071d2d68a6865d38a39f15

# ---------------------------------------------------------------------------
# Your administrator account
# ---------------------------------------------------------------------------
# Change this from the user menu once you are signed in -- top right, next to Sign out.
# Editing it here after the first start does nothing: the account is created once, and a
# marker file in the data volume stops it being registered again.
#
# No default: pick one before the first start. Changed it later from the user menu? Put the
# new value here too: verify.sh and the bootstrap job sign in with it.
#
# It needs at least 8 characters, with a lower case
# letter, an upper case letter, a digit, and one of  $ @ ! % * ? &  -- other punctuation is
# rejected and the first start fails.
ZETARIS_ADMIN_PASSWORD=
ZETARIS_ADMIN_EMAIL=admin@zetaris.com
ZETARIS_ADMIN_ORG=zetaris

# The database. Not published outside this deployment's network, so this is a fixed value.
# Changing it after the first start locks the platform out of its own database: Postgres only
# applies a password when it creates an empty data directory.
POSTGRES_USER=zetaris
POSTGRES_PASSWORD=zt-metastore-6f2a9c41d0b7

# ---------------------------------------------------------------------------
# Sizing -- the one choice that decides how fast queries run
# ---------------------------------------------------------------------------
# Sized for a laptop: about 3 GB across all services. The query engine uses exactly the heap
# it is given, so raise these on a machine with room. See .env.server.example.
ZSPARK_DRIVER_MEM=2g
ZSPARK_DRIVER_CORES=2
ZSPARK_MASTER_URL=local[2]
ZETARIS_API_MAX_HEAP=1g

# ---------------------------------------------------------------------------
# Addresses
# ---------------------------------------------------------------------------
# The platform is reached at http://localhost:3001. These must match that exactly or the
# browser's origin check fails. Moved off the default 3000, which nm-web already publishes
# on this machine.
UI_PORT=3001
ALLOWED_ORIGINS=http://localhost:3001
GUI_URL=http://localhost:3001

# Bound to this machine only. Nothing here needs to be reachable from the network.
API_PORT=8888
API_INTERNAL_PORT=8889
DRIVER_PORT=10000
SPARK_UI_PORT=4040

# ---------------------------------------------------------------------------
# Fleet key
# ---------------------------------------------------------------------------
# Identifies this as a real Zetaris bundle when usage reporting is switched on.
# The same value in every copy, so it says nothing about who you are. Leave it
# alone; clearing it only means the reports are ignored.
TELEMETRY_KEY=2E59B16F-F24A-427C-90A6-8F5652B7E280

# ---------------------------------------------------------------------------
# Anonymous usage reporting
# ---------------------------------------------------------------------------
# Every few hours the platform posts a random id minted on this machine, its version,
# the OS and architecture, and how long it has been up. Nothing else: no account, no
# email, no hostname, no IP kept, and no query or data of yours. It is how we count
# how many of these installs are running.
#
# Leave this blank and the platform asks you once, the first time you open it, and
# sends nothing until you answer. Set it to false to decline up front and never be
# asked, or true to accept up front.
TELEMETRY_ENABLED=
